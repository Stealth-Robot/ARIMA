SECRET_KEY=change-me-to-a-random-64-char-hex-string
PEPPER=change-me-to-a-random-32-char-hex-string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=A.R.I.M.A.
FLASK_ENV=development  # set to 'production' for Railway/deployed environments
RESEND_API_KEY=  # get from resend.com/api-keys
APP_URL=  # production URL for email links (e.g. https://arima.yourdomain.com)
BACKUP_ENABLED=false  # set to 'true' to enable daily R2 backups
BACKUP_R2_ENDPOINT=  # https://<account-id>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY=  # R2 API access key ID
BACKUP_R2_SECRET_KEY=  # R2 API secret access key
BACKUP_R2_BUCKET=arima-backups  # R2 bucket name
SPOTIFY_CLIENT_ID=  # from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_SECRET=  # from https://developer.spotify.com/dashboard
SPOTIFY_MIN_REQUEST_INTERVAL=0.4  # min seconds between Spotify API calls (rate-limit pacing)
SPOTIFY_REDIRECT_URI=  # OAuth callback, must match the Spotify dashboard exactly (e.g. http://127.0.0.1:5000/spotify/callback or https://arima.yourdomain.com/spotify/callback). Leave blank to auto-derive from the request host.
SPOTIFY_OAUTH_CLIENT_ID=  # for allowing spotify to modify your playlists. first 5 users. Falls back to SPOTIFY_CLIENT_ID if blank.
SPOTIFY_OAUTH_CLIENT_SECRET=  # optional: secret for allowing spotify to modify your playlists. first 5 users. Falls back to SPOTIFY_CLIENT_SECRET if blank.
SPOTIFY_OAUTH_CLIENT_ID_2=  # for allowing spotify to modify your playlists. first 5 users. Falls back to SPOTIFY_CLIENT_ID if blank.
SPOTIFY_OAUTH_CLIENT_SECRET_2=  # optional: secret for allowing spotify to modify your playlists. first 5 users. Falls back to SPOTIFY_CLIENT_SECRET if blank.
RAILWAY_API_TOKEN=  # account/workspace token from railway.com/account/tokens — powers the Operational Stats page
RAILWAY_PROJECT_ID=  # auto-injected on Railway; set manually only for local testing
RAILWAY_SERVICE_ID=  # auto-injected on Railway; set manually only for local testing
RAILWAY_ENVIRONMENT_ID=  # auto-injected on Railway; set manually only for local testing
RAILWAY_RETENTION_ENABLED=false  # set to 'true' to poll + store metrics locally for history beyond Railway's 30-day limit
SIMUL_HOST=simuls.localhost:5000 # Local development only